# Populate secrets privately. Existing lowercase aliases in .env are supported.
OPENAI_API_KEY=
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
MF_PLANNER_MODEL=gpt-5.4-2026-03-05
MF_VISION_MODEL=gpt-5.4-2026-03-05
MF_REASONING_EFFORT=medium
MF_MAX_CAMPAIGN_API_USD=40.00
MF_MAX_INITIAL_API_USD=3.00
MF_MAX_REVISION_API_USD=2.00
MF_EXECUTION_MODE=structured_ops
